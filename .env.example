# Which database the app connects to: "development" (local) or "production" (Atlas).
MONGODB_ENV=development

# Used when MONGODB_ENV=development.
MONGODB_URI_DEVELOPMENT="mongodb://127.0.0.1:27017/gshs"

# Used when MONGODB_ENV=production. Atlas → Database → Connect → Drivers.
MONGODB_URI_PRODUCTION="mongodb+srv://<user>:<password>@<host>/gshs?retryWrites=true&w=majority"

# Signs the admin session cookie. Generate once with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-base64-string"

# Optional bootstrap credentials for `npm run create-admin`; the script
# prompts when these are not set.
# ADMIN_EMAIL="admin@goasciencehs.edu.ph"
# ADMIN_PASSWORD="at-least-12-characters"
